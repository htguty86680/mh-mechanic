# M&H Mobile Mechanic — Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3000

# Admin dashboard protection key (change this!)
ADMIN_KEY=mh-admin-2025-change-me

# Email notifications (use Gmail App Password, not your main password)
# Create an App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Where to send lead notifications (Mehdi's email)
NOTIFY_EMAIL=mehdi@example.com

# CORS (set to your website domain in production)
ALLOWED_ORIGIN=*
